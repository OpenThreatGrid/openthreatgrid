# OpenThreatGrid API configuration
# Copy to .env and adjust for your environment.

ENVIRONMENT=development

# OpenSearch — primary event store. Events land in daily indices (otg-events-*).
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=otg-events
# Leave blank when the security plugin is disabled (local dev). Set both for prod.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false

# Redis connection (readiness checks + ingestion queue)
REDIS_URL=redis://redis:6379/0
REDIS_EVENT_QUEUE=otg:events

# Ingestion limits
MAX_BATCH_SIZE=1000
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000
