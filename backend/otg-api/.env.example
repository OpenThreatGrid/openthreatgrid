# OpenThreatGrid API configuration
# Copy to .env and adjust for your environment.

ENVIRONMENT=development

# PostgreSQL connection (SQLAlchemy + psycopg3 driver)
DATABASE_URL=postgresql+psycopg://otg:otg@postgres:5432/otg

# Redis connection (readiness checks + ingestion queue)
REDIS_URL=redis://redis:6379/0
REDIS_EVENT_QUEUE=otg:events

# Ingestion limits
MAX_BATCH_SIZE=1000
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000
