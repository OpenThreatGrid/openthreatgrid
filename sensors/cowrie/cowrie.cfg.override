# OpenThreatGrid — Cowrie overrides (merged over Cowrie's cowrie.cfg.dist).
# Only the keys that differ from upstream defaults are set here.
#
# IMPORTANT: Cowrie listens on LOCALHOST high ports (12222/12223). A go-mmproxy
# sidecar fronts the real ports 2222/2223, terminates PROXY PROTOCOL v2 from
# Traefik, and forwards transparently so Cowrie sees the REAL attacker IP.
# (Cowrie has no native PROXY-protocol support.)

[honeypot]
hostname = srv-web-01
sensor_name = cowrie-prod-01

[ssh]
enabled = true
listen_endpoints = tcp:12222:interface=127.0.0.1
version = SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.1

[telnet]
enabled = true
listen_endpoints = tcp:12223:interface=127.0.0.1

# ─── OUTPUT: JSON log consumed by the OTG parser sidecar ───────────────
[output_jsonlog]
enabled = true
logfile = ${honeypot:log_path}/cowrie.json
epoch_timestamp = false

# Disable any output plugin that would reach the internet — the honeypot pod
# has no outbound network access (enforced by NetworkPolicy as well).
[output_virustotal]
enabled = false

[output_malshare]
enabled = false
